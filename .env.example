# Variáveis de Conexão do Firebase Spark (CinePWA)
# Obtenha estas credenciais no Firebase Console (Configurações do Projeto > Geral > Seus Aplicativos > Web App)
# Não inclua credenciais administrativas secretas nem chaves de serviço aqui.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
